{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://superstonk-dd-library.example/data/schema.json",
  "title": "SuperStonk DD Library canonical record",
  "type": "object",
  "required": [
    "pos",
    "title",
    "byline",
    "pages",
    "uploaded",
    "url",
    "type",
    "text_available"
  ],
  "properties": {
    "pos": {
      "type": "integer",
      "minimum": 1,
      "maximum": 250
    },
    "title": {
      "type": "string"
    },
    "byline": {
      "type": "string"
    },
    "pages": {
      "type": "integer",
      "minimum": 1
    },
    "uploaded": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "url": {
      "type": "string",
      "pattern": "^https?://"
    },
    "type": {
      "enum": [
        "compilation",
        "original",
        "art",
        "periodical"
      ]
    },
    "text_available": {
      "type": "boolean"
    },
    "is_compilation": {
      "type": "boolean"
    },
    "content_type": {
      "enum": [
        "periodical_news",
        "wealth_advice",
        "market_dd",
        "other",
        "guide_howto",
        "macro_analysis",
        "psychology_opinion"
      ]
    },
    "summary": {
      "type": "string"
    },
    "key_claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "constituents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/constituent"
      }
    },
    "evidence_quality": {
      "$ref": "#/$defs/rating"
    },
    "speculation_level": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "validity_rating": {
      "anyOf": [
        {
          "$ref": "#/$defs/rating"
        },
        {
          "type": "null"
        }
      ]
    },
    "rating_reconciled": {
      "type": "boolean"
    },
    "validity_rationale": {
      "type": "string"
    },
    "quality_variance": {
      "enum": [
        "uniform",
        "mixed",
        "na"
      ]
    },
    "confidence": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "topics": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "insufficient_text": {
      "type": "boolean"
    },
    "calibration": {
      "$ref": "#/$defs/calibration"
    },
    "author_response": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "rating": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "claim": {
      "type": "object",
      "required": [
        "claim",
        "kind",
        "assessment",
        "note"
      ],
      "properties": {
        "claim": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "verifiable_fact",
            "speculation",
            "prediction"
          ]
        },
        "assessment": {
          "enum": [
            "holds_up",
            "partially_holds",
            "does_not_hold",
            "cannot_assess"
          ]
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "constituent": {
      "type": "object",
      "required": [
        "title",
        "author",
        "one_line_claim"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "one_line_claim": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "calibration": {
      "type": "object",
      "required": [
        "validity",
        "evidence"
      ],
      "properties": {
        "validity": {
          "$ref": "#/$defs/rating"
        },
        "evidence": {
          "$ref": "#/$defs/rating"
        }
      },
      "additionalProperties": false
    }
  }
}
