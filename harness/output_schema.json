{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ErranttVenture/superstonk-dd-library/main/harness/output_schema.json",
  "$comment": "Recovered verbatim from the original per-book AI review output schema (the SCHEMA constant in the original workflow script). See PROVENANCE.md. Structured-output enforced per book by the review agent runtime — every field below the top level matches the original property order and names exactly.",
  "title": "SuperStonk per-book review output (original AI schema)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pos",
    "is_compilation",
    "content_type",
    "summary",
    "key_claims",
    "evidence_quality",
    "speculation_level",
    "validity_rating",
    "validity_rationale",
    "quality_variance",
    "confidence",
    "topics"
  ],
  "properties": {
    "pos": {
      "type": "integer"
    },
    "is_compilation": {
      "type": "boolean"
    },
    "content_type": {
      "enum": [
        "market_dd",
        "macro_analysis",
        "guide_howto",
        "psychology_opinion",
        "periodical_news",
        "wealth_advice",
        "other"
      ]
    },
    "summary": {
      "type": "string",
      "description": "Neutral 80-150 word summary of what the book argues/contains"
    },
    "key_claims": {
      "type": "array",
      "minItems": 2,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim",
          "kind",
          "assessment"
        ],
        "properties": {
          "claim": {
            "type": "string",
            "description": "One key claim, stated as a claim, e.g. \"Claims that short interest exceeded 200% of float via ETF-mediated naked shorting\""
          },
          "kind": {
            "enum": [
              "verifiable_fact",
              "speculation",
              "prediction"
            ]
          },
          "assessment": {
            "enum": [
              "holds_up",
              "partially_holds",
              "does_not_hold",
              "cannot_assess"
            ]
          },
          "note": {
            "type": "string",
            "description": "Brief justification, referencing hindsight facts or page numbers"
          }
        }
      }
    },
    "constituents": {
      "type": "array",
      "maxItems": 12,
      "description": "Compilations only: the major constituent articles found in the text",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "one_line_claim"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "author": {
            "type": "string"
          },
          "one_line_claim": {
            "type": "string"
          }
        }
      }
    },
    "evidence_quality": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "speculation_level": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "validity_rating": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "validity_rationale": {
      "type": "string",
      "description": "1-3 sentences tying the rating to the anchors and hindsight facts"
    },
    "quality_variance": {
      "enum": [
        "uniform",
        "mixed",
        "na"
      ],
      "description": "Compilations: uniform or mixed quality across constituents. Non-compilations: na"
    },
    "confidence": {
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "description": "Your confidence given text coverage (sampled books => at most medium)"
    },
    "topics": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "string"
      }
    }
  }
}
